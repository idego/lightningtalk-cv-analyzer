{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "document-analysis-schema-v8",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "facts", "findings", "unknowns", "analysis_limitations"],
  "properties": {
    "schema_version": {"type": "string", "const": "document-analysis-schema-v8"},
    "facts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contact", "education", "employment"],
      "properties": {
        "contact": {"type": "array", "maxItems": 3, "items": {"$ref": "#/$defs/contactFact"}},
        "education": {"type": "array", "items": {"$ref": "#/$defs/educationFact"}},
        "employment": {"type": "array", "items": {"$ref": "#/$defs/employmentFact"}}
      }
    },
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "unknowns": {"type": "array", "items": {"$ref": "#/$defs/unknown"}},
    "analysis_limitations": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["page_id", "line_id"],
      "properties": {
        "page_id": {"type": "string", "minLength": 1},
        "line_id": {"type": "string", "minLength": 1}
      }
    },
    "factField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "line_ids"],
      "properties": {
        "value": {"type": ["string", "null"]},
        "line_ids": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "contactFact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value", "status", "evidence"],
      "properties": {
        "kind": {"type": "string", "enum": ["candidate_name", "phone", "stated_location"]},
        "value": {"type": "string", "minLength": 1},
        "status": {"type": "string", "enum": ["present", "ambiguous"]},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}}
      }
    },
    "educationFact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "institution", "program", "study_dates", "status"],
      "properties": {
        "kind": {"type": "string", "const": "education"},
        "institution": {"$ref": "#/$defs/factField"},
        "program": {"$ref": "#/$defs/factField"},
        "study_dates": {"$ref": "#/$defs/factField"},
        "status": {"type": "string", "enum": ["present", "ambiguous"]}
      }
    },
    "employmentFact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "organization", "role", "employment_dates", "location", "relationship_type", "status"],
      "properties": {
        "kind": {"type": "string", "const": "employment"},
        "organization": {"$ref": "#/$defs/factField"},
        "role": {"$ref": "#/$defs/factField"},
        "employment_dates": {"$ref": "#/$defs/factField"},
        "location": {"$ref": "#/$defs/factField"},
        "relationship_type": {"$ref": "#/$defs/factField"},
        "status": {"type": "string", "enum": ["present", "ambiguous"]}
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "status", "observation", "reason", "importance", "confidence", "limitation", "material_effect", "affected_fact", "evidence"],
      "properties": {
        "category": {"type": "string", "enum": ["contact_conflict", "missing_contact_data", "timeline_gap", "timeline_overlap", "duration_claim_conflict", "relationship_ambiguity", "document_artifact", "semantic_outlier", "internal_fact_conflict"]},
        "status": {"type": "string", "enum": ["conflicting", "unconfirmed", "missing"]},
        "observation": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1},
        "importance": {"type": "string", "enum": ["attention", "worth_knowing", "remaining"]},
        "confidence": {"type": "string", "enum": ["high", "medium", "low"]},
        "limitation": {"type": "string", "minLength": 1},
        "material_effect": {"type": "string", "enum": ["none", "important_fact_unreadable", "meaning_changed"]},
        "affected_fact": {"type": "string", "enum": ["not_applicable", "candidate_name", "phone", "stated_location", "education", "employment", "employment_dates", "timeline", "relationship", "document_meaning", "other_material_fact"]},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}}
      }
    },
    "unknown": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "reason"],
      "properties": {
        "field": {"type": "string", "enum": ["candidate_name", "phone", "stated_location", "education_institution", "education_program", "education_dates", "employment_organization", "employment_role", "employment_dates", "employment_location", "relationship_type"]},
        "reason": {"type": "string", "minLength": 1}
      }
    }
  }
}
