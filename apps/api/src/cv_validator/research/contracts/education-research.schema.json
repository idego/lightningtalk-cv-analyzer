{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "outcome", "credentials", "searches_performed", "search_limitations"],
  "properties": {
    "schema_version": {"type": "string", "const": "education-research-schema-v3"},
    "outcome": {"type": "string", "enum": ["completed", "insufficient_evidence"]},
    "credentials": {"type": "array", "maxItems": 12, "items": {"$ref": "#/$defs/credential"}},
    "searches_performed": {"type": "array", "maxItems": 4, "items": {"type": "string", "minLength": 1}},
    "search_limitations": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "nullableString": {"type": ["string", "null"]},
    "finding": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "summary", "source_urls", "confidence", "uncertainty"],
      "properties": {
        "kind": {"type": "string", "enum": ["program", "degree", "dates", "location", "cv_consistency"]},
        "summary": {"type": "string", "minLength": 1},
        "source_urls": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^https://"}},
        "confidence": {"type": "string", "enum": ["low", "medium", "high"]},
        "uncertainty": {"type": "string", "minLength": 1}
      }
    },
    "credential": {
      "type": "object", "additionalProperties": false,
      "required": ["institution", "program", "degree", "program_exists", "degree_exists", "dates", "city", "country", "cv_consistency", "location_difference_for_review", "confidence", "uncertainty", "findings"],
      "properties": {
        "institution": {"$ref": "#/$defs/nullableString"},
        "program": {"$ref": "#/$defs/nullableString"},
        "degree": {"$ref": "#/$defs/nullableString"},
        "program_exists": {"type": "string", "enum": ["supported", "mismatch", "evidence_unavailable"]},
        "degree_exists": {"type": "string", "enum": ["supported", "mismatch", "evidence_unavailable"]},
        "dates": {"$ref": "#/$defs/nullableString"},
        "city": {"$ref": "#/$defs/nullableString"},
        "country": {"$ref": "#/$defs/nullableString"},
        "cv_consistency": {"type": "string", "enum": ["supported", "mismatch", "evidence_unavailable"]},
        "location_difference_for_review": {"$ref": "#/$defs/nullableString"},
        "confidence": {"type": "string", "enum": ["low", "medium", "high"]},
        "uncertainty": {"type": "string", "minLength": 1},
        "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}}
      }
    }
  }
}
