{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "outcome", "profile_url", "comparisons", "searches_performed", "limitations"],
  "properties": {
    "schema_version": {"type": "string", "const": "linkedin-comparison-schema-v1"}, "outcome": {"type": "string", "enum": ["completed", "insufficient_evidence"]},
    "profile_url": {"type": "string", "format": "uri", "pattern": "^https://(www\\.)?linkedin\\.com/in/"},
    "comparisons": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"type": "object", "additionalProperties": false, "required": ["field", "status", "cv_value", "profile_value", "summary", "source_urls", "confidence", "uncertainty"], "properties": {
      "field": {"type": "string", "enum": ["companies", "roles", "dates", "stated_location", "education"]}, "status": {"type": "string", "enum": ["consistent", "mismatch_for_review", "unknown"]},
      "cv_value": {"type": ["string", "null"]}, "profile_value": {"type": ["string", "null"]}, "summary": {"type": "string", "minLength": 1},
      "source_urls": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "format": "uri", "pattern": "^https://"}},
      "confidence": {"type": "string", "enum": ["low", "medium", "high"]}, "uncertainty": {"type": "string", "minLength": 1}
    }}}, "searches_performed": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"type": "string", "minLength": 1}}, "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}
