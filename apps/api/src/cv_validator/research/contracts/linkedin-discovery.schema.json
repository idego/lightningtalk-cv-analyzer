{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "outcome", "possible_profiles", "linkedin_not_found", "not_found_caveat", "searches_performed", "search_limitations"],
  "properties": {
    "schema_version": {"type": "string", "const": "linkedin-discovery-schema-v1"},
    "outcome": {"type": "string", "enum": ["completed", "ambiguous", "insufficient_evidence"]},
    "possible_profiles": {"type": "array", "maxItems": 5, "items": {"$ref": "#/$defs/profile"}},
    "linkedin_not_found": {"type": "boolean"},
    "not_found_caveat": {"type": "string", "minLength": 1},
    "searches_performed": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"type": "string", "minLength": 1}},
    "search_limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "sourceUrls": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "format": "uri", "pattern": "^https://"}},
    "evidence": {"type": "object", "additionalProperties": false, "required": ["field", "cv_value", "profile_value", "source_urls"], "properties": {
      "field": {"type": "string", "enum": ["name", "company", "role", "dates", "location", "education"]},
      "cv_value": {"type": "string", "minLength": 1}, "profile_value": {"type": "string", "minLength": 1}, "source_urls": {"$ref": "#/$defs/sourceUrls"}
    }},
    "conflict": {"type": "object", "additionalProperties": false, "required": ["field", "summary", "source_urls"], "properties": {
      "field": {"type": "string", "enum": ["name", "company", "role", "dates", "location", "education"]}, "summary": {"type": "string", "minLength": 1}, "source_urls": {"$ref": "#/$defs/sourceUrls"}
    }},
    "count": {"type": "object", "additionalProperties": false, "required": ["visibility", "minimum", "maximum", "display", "source_url"], "properties": {
      "visibility": {"type": "string", "enum": ["visible", "unknown"]}, "minimum": {"type": ["integer", "null"], "minimum": 0}, "maximum": {"type": ["integer", "null"], "minimum": 0}, "display": {"type": ["string", "null"]}, "source_url": {"type": ["string", "null"], "format": "uri"}
    }},
    "profile": {"type": "object", "additionalProperties": false, "required": ["profile_url", "source_urls", "match_evidence", "conflicts", "confidence", "uncertainty", "photo_visible", "photo_source_url", "connection_count", "connection_completeness_flag"], "properties": {
      "profile_url": {"type": "string", "format": "uri", "pattern": "^https://(www\\.)?linkedin\\.com/in/"}, "source_urls": {"$ref": "#/$defs/sourceUrls"},
      "match_evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}}, "conflicts": {"type": "array", "items": {"$ref": "#/$defs/conflict"}},
      "confidence": {"type": "string", "enum": ["low", "medium", "high"]}, "uncertainty": {"type": "string", "minLength": 1},
      "photo_visible": {"type": "string", "enum": ["true", "false", "unknown"]}, "photo_source_url": {"type": ["string", "null"], "format": "uri"},
      "connection_count": {"$ref": "#/$defs/count"}, "connection_completeness_flag": {"type": "boolean"}
    }}
  }
}
