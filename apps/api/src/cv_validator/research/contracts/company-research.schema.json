{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "outcome", "organizations", "searches_performed", "search_limitations"],
  "properties": {
    "schema_version": {"type": "string", "const": "company-research-schema-v1"},
    "outcome": {"type": "string", "enum": ["completed", "insufficient_evidence"]},
    "organizations": {"type": "array", "maxItems": 12, "items": {"$ref": "#/$defs/organization"}},
    "searches_performed": {"type": "array", "maxItems": 4, "items": {"type": "string", "minLength": 1}},
    "search_limitations": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "nullableString": {"type": ["string", "null"]},
    "finding": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "summary", "source_urls", "confidence", "uncertainty"],
      "properties": {
        "kind": {"type": "string", "enum": ["public_footprint", "activity", "dates", "location", "relationship", "official_website", "company_page", "registry"]},
        "summary": {"type": "string", "minLength": 1},
        "source_urls": {"type": "array", "minItems": 1, "items": {"type": "string", "format": "uri"}},
        "confidence": {"type": "string", "enum": ["low", "medium", "high"]},
        "uncertainty": {"type": "string", "minLength": 1}
      }
    },
    "organization": {
      "type": "object", "additionalProperties": false,
      "required": ["query_subject", "existence", "activity", "operating_dates", "location", "relationship", "official_website", "company_pages", "registries", "confidence", "uncertainty", "findings", "limited_online_presence", "limited_online_presence_reason"],
      "properties": {
        "query_subject": {"type": "string", "minLength": 1},
        "existence": {"type": "string", "enum": ["supported", "conflicting", "insufficient_evidence"]},
        "activity": {"$ref": "#/$defs/nullableString"},
        "operating_dates": {"$ref": "#/$defs/nullableString"},
        "location": {"$ref": "#/$defs/nullableString"},
        "relationship": {"$ref": "#/$defs/nullableString"},
        "official_website": {"$ref": "#/$defs/nullableString"},
        "company_pages": {"type": "array", "items": {"type": "string", "format": "uri"}},
        "registries": {"type": "array", "items": {"type": "string", "format": "uri"}},
        "confidence": {"type": "string", "enum": ["low", "medium", "high"]},
        "uncertainty": {"type": "string", "minLength": 1},
        "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
        "limited_online_presence": {"type": "boolean"},
        "limited_online_presence_reason": {"$ref": "#/$defs/nullableString"}
      }
    }
  }
}
