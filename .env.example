# Host port published by Docker (container always listens on 3000 internally).
# Keep this on loopback; the host TLS reverse proxy is the public ingress.
WEB_HOST=127.0.0.1
WEB_PORT=3001

# Public URL used by the browser and Better Auth callbacks (must match WEB_PORT)
BASE_URL=http://localhost:3001
BETTER_AUTH_URL=http://localhost:3001
BETTER_AUTH_SECRET=replace-with-random-32-char-secret
BETTER_AUTH_DB_PATH=/app/data/auth.db

# Google OAuth
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
ALLOWED_EMAIL_DOMAINS=idego.io

# Local development only. Authentication remains enabled by default.
# When true, BASE_URL must use localhost, 127.0.0.1, or ::1.
LOCAL_DEV_AUTH_BYPASS=false

# Internal web -> api routing
INTERNAL_API_URL=http://api:8000

# API retention settings
CV_VALIDATOR_DB_PATH=/app/data/cv_analyzer.db
CV_VALIDATOR_RETENTION_DAYS=90

# Public AI research and the docling-luna base-analysis strategy both use
# OPENAI_API_KEY. Never commit a real key.
CV_VALIDATOR_AI_ENABLED=true
OPENAI_API_KEY=
# Optional overrides. The pinned model is enforced by the API; the timeout is seconds.
# OPENAI_MODEL=gpt-5.6-luna
# OPENAI_REQUEST_TIMEOUT_SECONDS=120

# Synchronous batch limits. The API preflights both before analysis.
CV_VALIDATOR_UPLOAD_MAX_BYTES=20971520
CV_VALIDATOR_RESEARCH_CACHE_TTL_DAYS=30
# Optional JSON rate catalog; unknown models retain tokens with a null cost.
CV_VALIDATOR_PRICING_PATH=
CV_VALIDATOR_LINKEDIN_CONNECTION_THRESHOLD=500
CV_VALIDATOR_LINKEDIN_MAX_PROFILES=3

# Contextual feedback: initial owner emails are seeded from
# config/feedback-access.json by the one-shot feedback-init service.

# Compose builds both offline GeoNames indexes once in a persistent named volume.
# Change this date-like version explicitly when refreshing upstream data.
GEONAMES_SNAPSHOT_VERSION=2026-09-02
# Official HTTPS sources are defaults; set these only for an approved mirror.
# GEONAMES_CITIES500_URL=https://download.geonames.org/export/dump/cities500.zip
# GEONAMES_COUNTRY_INFO_URL=https://download.geonames.org/export/dump/countryInfo.txt
# GEONAMES_ALTERNATE_NAMES_URL=https://download.geonames.org/export/dump/alternateNamesV2.zip
# GEONAMES_POSTAL_CODES_URL=https://download.geonames.org/export/zip/allCountries.zip

# Offline/operator mode only. The directory must contain both locality and
# postal index/manifest pairs. Start with REFERENCE_DATA_MODE=operator.
# CV_VALIDATOR_REFERENCE_DATA_DIR=./data/geonames-build/2026-09-02

# The API is only reachable inside the Compose network. For Swagger during
# local development, `make dev` adds docker-compose.dev.yml, which publishes
# the API on http://127.0.0.1:${API_DEV_PORT}/docs (loopback only).
# API_DEV_PORT=8001
# Location indexes are wired by Compose (CV_VALIDATOR_LOCATION_*_PATH,
# CV_VALIDATOR_POSTAL_*_PATH, CV_VALIDATOR_REQUIRE_LOCATION_RESOLVER) and
# rarely need overriding. Makefile knobs: DOCKER_CONTEXT, ALLOW_DEGRADED,
# COMPOSE_PROJECT_NAME, REFERENCE_DATA_MODE, WEB_PORT.
