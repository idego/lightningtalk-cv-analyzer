# Host port published by Docker (container always listens on 3000 internally).
# Keep this on loopback; the host TLS reverse proxy is the public ingress.
WEB_HOST=127.0.0.1
WEB_PORT=3001

# Public URL used by the browser and Better Auth callbacks (must match WEB_PORT)
BASE_URL=http://localhost:3001
BETTER_AUTH_URL=http://localhost:3001
BETTER_AUTH_SECRET=replace-with-random-32-char-secret
BETTER_AUTH_DB_PATH=/app/data/auth.db

# Google OAuth
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
ALLOWED_EMAIL_DOMAINS=idego.io

# Local development only. Authentication remains enabled by default.
# When true, BASE_URL must use localhost, 127.0.0.1, or ::1.
LOCAL_DEV_AUTH_BYPASS=false

# Internal web -> api routing
INTERNAL_API_URL=http://api:8000

# API retention settings
CV_VALIDATOR_DB_PATH=/app/data/cv_analyzer_v2.db
CV_VALIDATOR_RETENTION_DAYS=90

# Contextual feedback is disabled until schema initialization and secrets are configured.
CV_VALIDATOR_FEEDBACK_ENABLED=false
CV_VALIDATOR_FEEDBACK_INBOX_ENABLED=false
CV_VALIDATOR_FEEDBACK_FAILURES_ENABLED=false
CV_VALIDATOR_FEEDBACK_HMAC_SECRET=replace-with-random-32-char-secret
CV_VALIDATOR_FEEDBACK_INTERNAL_TOKEN=replace-with-random-high-entropy-token

# Public AI research. The shared branch has no base-analysis strategy; each
# experiment installs its own strategy separately. Never commit a real key.
CV_VALIDATOR_AI_ENABLED=false
OPENAI_API_KEY=

# Synchronous batch limits. The API preflights both before analysis.
CV_VALIDATOR_BATCH_MAX_FILES=4
CV_VALIDATOR_BATCH_MAX_BYTES=20971520
CV_VALIDATOR_RESEARCH_CACHE_TTL_DAYS=30
# Optional JSON rate catalog; unknown models retain tokens with a null cost.
CV_VALIDATOR_PRICING_PATH=
CV_VALIDATOR_LINKEDIN_CONNECTION_THRESHOLD=500
CV_VALIDATOR_LINKEDIN_MAX_PROFILES=3

# Versioned host directory containing locations.sqlite3 and locations.manifest.json
CV_VALIDATOR_REFERENCE_DATA_DIR=./data/geonames-build/2026-08-21

# Optional offline GeoNames postal-code index. When omitted, postal validation
# is reported as unavailable rather than inferred from country regexes.
CV_VALIDATOR_POSTAL_INDEX_PATH=
CV_VALIDATOR_POSTAL_MANIFEST_PATH=
