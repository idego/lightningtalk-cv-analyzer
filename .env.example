# Host port published by Docker (container always listens on 3000 internally).
# Keep this on loopback; the host TLS reverse proxy is the public ingress.
WEB_HOST=127.0.0.1
WEB_PORT=3001

# Public URL used by the browser and Better Auth callbacks (must match WEB_PORT)
BASE_URL=http://localhost:3001
BETTER_AUTH_URL=http://localhost:3001
BETTER_AUTH_SECRET=replace-with-random-32-char-secret
BETTER_AUTH_DB_PATH=/app/data/auth.db

# Google OAuth
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
ALLOWED_EMAIL_DOMAINS=idego.io

# Local development only. Authentication remains enabled by default.
# When true, BASE_URL must use localhost, 127.0.0.1, or ::1.
LOCAL_DEV_AUTH_BYPASS=false

# Internal web -> api routing
INTERNAL_API_URL=http://api:8000

# API retention settings
CV_VALIDATOR_RETENTION_DAYS=90

# Minimum document-level meaningful-token count accepted by ingestion
CV_VALIDATOR_MINIMUM_MEANINGFUL_TOKENS=5

# Informational only; 0 disables the small non-EU locality flag
CV_VALIDATOR_SMALL_LOCALITY_MAX_POPULATION=10000

# Synchronous AI document analysis. Disabled is the safe default and does not
# require an OpenAI secret. When enabled, startup fails unless OPENAI_API_KEY is
# set. Never commit a real key.
CV_VALIDATOR_AI_ENABLED=false
OPENAI_API_KEY=
CV_VALIDATOR_AI_TRANSPORT_RETRY_LIMIT=1
CV_VALIDATOR_AI_INVALID_RESPONSE_RETRY_LIMIT=1
CV_VALIDATOR_AI_ABSOLUTE_ATTEMPT_LIMIT=3

# V1 synchronous batch limits. The API preflights both before analysis.
CV_VALIDATOR_BATCH_MAX_FILES=4
CV_VALIDATOR_BATCH_MAX_BYTES=20971520
CV_VALIDATOR_RESEARCH_CACHE_TTL_DAYS=30
CV_VALIDATOR_LINKEDIN_CONNECTION_THRESHOLD=500
CV_VALIDATOR_LINKEDIN_MAX_PROFILES=3

# Versioned host directory containing locations.sqlite3 and locations.manifest.json
CV_VALIDATOR_REFERENCE_DATA_DIR=./data/geonames-build/2026-08-21

# Bounded public-link inspection. Set false for a fully offline/degraded run.
CV_VALIDATOR_LINK_CHECK_ENABLED=true
CV_VALIDATOR_LINK_CHECK_PROTOCOLS=https,http
CV_VALIDATOR_LINK_CHECK_PORTS=80,443
CV_VALIDATOR_LINK_CHECK_TIMEOUT_SECONDS=5
CV_VALIDATOR_LINK_CHECK_MAX_RESPONSE_BYTES=65536
CV_VALIDATOR_LINK_CHECK_MAX_REDIRECTS=3
CV_VALIDATOR_LINK_CHECK_MAX_CONCURRENCY=4
CV_VALIDATOR_LINK_CHECK_MAX_RETRIES=0
CV_VALIDATOR_LINK_CHECK_TOTAL_BUDGET_SECONDS=20
CV_VALIDATOR_LINK_CHECK_USER_AGENT=CV-Validator-Link-Checker/1
